# ====================================================
# GAMINGZONE Platform Server Configuration (Template)
# ====================================================

PORT=8080
NODE_ENV=production

# Admin Authentication Credentials (CHANGE IN PRODUCTION)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_to_a_strong_password

# Cryptographic token secret (GENERATE A STRONG 64-CHAR KEY)
JWT_SECRET=generate_a_random_cryptographic_secret_key_here

# Maximum game bundle upload size in Megabytes
MAX_UPLOAD_SIZE_MB=50

# Database & Storage paths
DB_PATH=data/gamingzone.db
UPLOADS_DIR=uploads

